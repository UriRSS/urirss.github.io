@page "/about"
@inject IStringLocalizer<Lang> Loc

<h1>@Loc["AboutMe"]</h1>
<p class="subtitle">@Loc["AboutMeSubtitle"]</p>

<div class="card">
    <h3>👨‍💻</h3>
    <p style="line-height: 1.7; color: #94a3b8;">
        @Loc["AboutMeMainText"]
    </p>
    <p style="line-height: 1.7; color: #94a3b8; margin-top: 12px;">
        @Loc["AboutMeLogisticsText"]
    </p>
    <p style="line-height: 1.7; color: #94a3b8; margin-top: 12px;">
        @Loc["AboutMeMobileText"]
    </p>
</div>
<div class="card">
    <h3>🌐 @Loc["LanguagesTitle"]</h3>
    <ul style="color: #94a3b8; line-height: 2; list-style-type: none; padding-left: 0; margin: 0;">
        <li><span style="color: #38bdf8; font-weight: bold; margin-right: 8px;">✔</span><strong>@Loc["Kyrgyz"]</strong> — @Loc["LangNative"]</li>
        <li><span style="color: #38bdf8; font-weight: bold; margin-right: 8px;">✔</span><strong>@Loc["Russian"]</strong> — @Loc["LangFluent"]</li>
        <li><span style="color: #38bdf8; font-weight: bold; margin-right: 8px;">✔</span><strong>@Loc["Italian"]</strong> — @Loc["LangFluent"]</li>
        <li><span style="color: #38bdf8; font-weight: bold; margin-right: 8px;">✔</span><strong>@Loc["English"]</strong> — @Loc["LangUpperInter"]</li>
    </ul>
</div>
