@page "/"
@inject IStringLocalizer<Lang> Loc

<div class="hero">
    <h1>@Loc["Hello"]</h1>
    <p class="subtitle">@Loc["Developer"]</p>
    <div class="btn-container">
        <a href="/contact" class="btn">@Loc["ContactMe"]</a>
        <a href="/projects" class="btn btn-outline">@Loc["ProjectsTitle"]</a>
    </div>
</div>

<div class="card">
    <h3>🚀 @Loc["TechStack"]</h3>
    <div class="tag-container">
        <span class="tag">C#</span>
        <span class="tag">NET Framework</span>
        <span class="tag">.NET Core</span>
        <span class="tag">ASP.NET Core</span>
        <span class="tag">Entity Framework</span>
        <span class="tag">.NET Core MVC</span>
        <span class="tag">Blazor C#</span>
        <span class="tag">1С:Конфигуратор</span>
        <span class="tag">SQL Server</span>
        <span class="tag">PostgreSQL</span>
        <span class="tag">Vue.js</span>
        <span class="tag">Flutter</span>
        <span class="tag">windows forms c#</span>
        <span class="tag">devexpress c#</span>
        <span class="tag">REST API</span>
        <span class="tag">WPF</span>
        <span class="tag">Git</span>
        <span class="tag">swagger</span>
        <span class="tag">postman</span>
        <span class="tag">IIS - </span>
    </div>
</div>

